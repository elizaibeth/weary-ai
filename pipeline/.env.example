# Loaded automatically. Exported variables take precedence over this file.
# `python -m agent --local` ignores the Slack and image settings below.

# --- Required ---------------------------------------------------------------
# Text models (ranking, writing, repair) and images are billed through Runware.
RUNWARE_API_KEY=
# TypeSafe verifies each paragraph against the evidence passages it cites.
TYPESAFE_API_KEY=

# --- Optional: text models --------------------------------------------------
# Runware model IDs. Each role defaults to GPT-5.4 mini when unset.
WEARY_RESEARCH_MODEL=openai:gpt@5.4-mini
WEARY_WRITER_MODEL=openai:gpt@5.4-mini
WEARY_REPAIRER_MODEL=openai:gpt@5.4-mini
# The Saturday opinion column (default: GPT-5.5).
WEARY_OPINION_MODEL=openai:gpt@5.5
# Used once when the primary model's backend returns a 429 or 5xx.
WEARY_LLM_FALLBACK_MODEL=google:gemini@3.1-flash-lite
# Set to "legacy" to switch the daily run back to the old ranking (rollback only).
WEARY_RANKING=

# --- Optional: images -------------------------------------------------------
# Image generation costs money per call and is off by default; a free
# placeholder is used until this is true.
WEARY_GENERATE_IMAGES=false
# "runware" (default) or "openai".
WEARY_IMAGE_PROVIDER=runware
# A Runware model string (e.g. runware:100@1) or an OpenAI image model.
WEARY_IMAGE_MODEL=runware:100@1
# Only needed when WEARY_IMAGE_PROVIDER=openai.
OPENAI_API_KEY=

# --- Optional: search -------------------------------------------------------
# Brave Search finds primary sources when a reporting lead does not link to
# one, and finds headlines for historical backfills. Optional: without it,
# the pipeline uses official feeds and the allowlisted links in articles.
BRAVE_SEARCH_API_KEY=
WEARY_SEARCH_REQUESTS_PER_RUN=6
WEARY_SEARCH_REQUESTS_PER_DAY=6
WEARY_SEARCH_REQUESTS_PER_MONTH=100
# true saves Brave results to disk between runs; only if your Brave plan allows storing results.
WEARY_BRAVE_STORAGE_ALLOWED=false

# --- Optional: publishing and alerts ----------------------------------------
# true publishes verified articles live; false saves every article as a draft.
WEARY_AUTO_PUBLISH=false
# Slack incoming webhook for success and failure alerts (with run cost).
# Leave unset to disable; a failed send never fails the run.
SLACK_WEBHOOK_URL=
# Canonical site URL for links in alerts (default: https://weary.ai/).
WEARY_BASE_URL=

# --- Optional: logging ------------------------------------------------------
# DEBUG, INFO (default), WARNING or ERROR. Warnings are labelled in the log.
WEARY_LOG_LEVEL=INFO
